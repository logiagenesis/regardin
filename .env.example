# No secret values belong here. Preview is the safe build default.
SITE_MODE=preview
# Public Formspree form URL. Never put account keys or passwords here.
FORMSPREE_ENDPOINT=
# Public verification and measurement identifiers; tracking stays off in beta.
GOOGLE_SITE_VERIFICATION=
VITE_GA4_ID=
VITE_GTM_ID=
VITE_ANALYTICS_ENABLED=false
VITE_MEASUREMENT_MODE=preview
# Optional local test executable; host PHP is selected through cPanel.
# PHP_BIN=/absolute/path/to/php
# cPanel runtime configuration belongs outside public_html:
# REGARDIN_PRIVATE=/absolute/private/directory
# REGARDIN_CONFIG=/absolute/private/config.php
# See hosting/cpanel/private/config.example.php and docs/cpanel-deployment.md.
